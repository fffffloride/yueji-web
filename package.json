{
  "name": "yueji-mp",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "description": "悦己 DLumière 医美微信小程序",
  "scripts": {
    "dev:h5": "uni",
    "dev:mp-weixin": "uni -p mp-weixin",
    "build:h5": "uni build",
    "build:mp-weixin": "uni build -p mp-weixin",
    "check:catalog-scroll": "node --no-warnings --experimental-strip-types scripts/catalog-scroll-check.mts",
    "check:checkout": "node --no-warnings --experimental-strip-types scripts/checkout-source-check.mts",
    "check:group-buy": "node --no-warnings --experimental-strip-types scripts/group-buy-check.mts",
    "check:member-level": "node --no-warnings --experimental-strip-types scripts/member-level-check.mts",
    "check:floating-action": "node --no-warnings --experimental-strip-types scripts/floating-action-check.mts",
    "check:appointment": "node --no-warnings --experimental-strip-types scripts/appointment-check.mts",
    "verify:ui": "eslint src --max-warnings=0 && stylelint \"src/**/*.{vue,scss,css}\" && pnpm type-check && pnpm check:catalog-scroll && pnpm check:checkout && pnpm check:group-buy && pnpm check:member-level && pnpm check:floating-action && pnpm check:appointment && pnpm build:h5 && pnpm build:mp-weixin",
    "type-check": "vue-tsc --noEmit",
    "lint": "eslint . --fix",
    "lint:style": "stylelint \"src/**/*.{vue,scss,css}\" --fix",
    "format": "prettier --write \"src/**/*.{ts,js,vue,json,scss}\"",
    "prepare": "husky"
  },
  "dependencies": {
    "@dcloudio/uni-app": "3.0.0-5020320260806002",
    "@dcloudio/uni-components": "3.0.0-5020320260806002",
    "@dcloudio/uni-h5": "3.0.0-5020320260806002",
    "@dcloudio/uni-mp-weixin": "3.0.0-5020320260806002",
    "pinia": "^2.2.6",
    "vue": "^3.4.21",
    "wot-design-uni": "^1.11.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.6.0",
    "@commitlint/config-conventional": "^19.6.0",
    "@dcloudio/types": "^3.4.8",
    "@dcloudio/uni-automator": "3.0.0-5020320260806002",
    "@dcloudio/uni-cli-shared": "3.0.0-5020320260806002",
    "@dcloudio/uni-stacktracey": "3.0.0-5020320260806002",
    "@dcloudio/vite-plugin-uni": "3.0.0-5020320260806002",
    "@eslint/js": "^9.39.5",
    "@uni-helper/uni-app-types": "^1.0.0-alpha.6",
    "@unocss/preset-uno": "^0.65.4",
    "@vue/runtime-core": "^3.4.21",
    "@vue/tsconfig": "^0.5.1",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-vue": "^9.32.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.11",
    "miniprogram-api-typings": "^4.0.4",
    "pinia-plugin-persistedstate": "^3.2.1",
    "postcss-html": "^2.0.0",
    "prettier": "^3.4.2",
    "sass": "^1.83.0",
    "stylelint": "^16.12.0",
    "stylelint-config-recess-order": "^5.1.1",
    "stylelint-config-standard-scss": "^14.0.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "unocss": "^0.65.4",
    "unocss-applet": "^0.9.0",
    "unplugin-auto-import": "^0.19.0",
    "vite": "5.2.8",
    "vue-tsc": "^2.1.10"
  },
  "lint-staged": {
    "*.{ts,js,vue}": "eslint --fix",
    "*.{vue,scss,css}": "stylelint --fix",
    "*.{json,md}": "prettier --write"
  }
}
